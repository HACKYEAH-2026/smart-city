# Wzór /opt/app/.env na serwerze. W CI zapisywany z GitHub Secrets (environment: staging/production).
API_IMAGE=ghcr.io/OWNER/factory-template-api
BACKUP_IMAGE=ghcr.io/OWNER/factory-template-backup
API_TAG=latest
API_DOMAIN=api.example.com
API_URL=https://api.example.com
TRUSTED_ORIGINS=https://app.example.com,capacitor://localhost,https://localhost
BETTER_AUTH_SECRET=change-me-at-least-32-characters-long
# Backup -> Cloudflare R2 (retencja: reguła lifecycle bucketa w OpenTofu)
R2_BUCKET=
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BACKUP_PREFIX=staging
BACKUP_SCHEDULE=0 3 * * *
