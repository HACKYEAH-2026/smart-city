{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "types": ["bun"],
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "app",
    "src",
    "e2e",
    "scripts",
    "app.config.ts",
    "paraglide.config.ts",
    "playwright.config.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
