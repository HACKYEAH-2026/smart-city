{
  "name": "@app/app",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "typecheck": "tsc -p .",
    "dev": "expo start",
    "build": "expo export --platform web --clear && bun scripts/postexport.ts",
    "preview": "bun scripts/serve.ts",
    "e2e": "playwright test",
    "android:debug": "expo prebuild --platform android --no-install && cd android && ./gradlew assembleDebug --no-daemon -q -PreactNativeArchitectures=arm64-v8a"
  },
  "dependencies": {
    "@app/plugin-sdk": "workspace:*",
    "@app/shared": "workspace:*",
    "@expo-google-fonts/barlow-condensed": "^0.4.1",
    "@expo-google-fonts/schibsted-grotesk": "^0.4.2",
    "@expo/metro-runtime": "~57.0.16",
    "@tanstack/react-query": "^5.90.0",
    "better-auth": "^1.7.5",
    "expo": "~57.0.25",
    "expo-constants": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.23",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "hono": "^4.13.8",
    "lucide-react-native": "^1.51.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.3"
  },
  "devDependencies": {
    "@app/api": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@types/react": "~19.2.0",
    "typescript": "~6.0.3"
  }
}
