{
  "name": "@app/app",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "i18n": "bun scripts/i18n.ts",
    "typecheck": "bun run i18n && tsc -p .",
    "dev": "bun run i18n && expo start",
    "build": "bun run i18n && expo export --platform web --clear && bun scripts/postexport.ts",
    "preview": "bun scripts/serve.ts",
    "e2e": "bun run i18n && playwright test",
    "android:debug": "bun run i18n && expo prebuild --platform android --no-install && cd android && ./gradlew assembleDebug --no-daemon -q -PreactNativeArchitectures=arm64-v8a",
    "check:worker": "WRANGLER_SEND_METRICS=false wrangler deploy --dry-run --env staging"
  },
  "dependencies": {
    "@app/shared": "workspace:*",
    "@expo/metro-runtime": "~57.0.16",
    "@tanstack/react-query": "^5.90.0",
    "better-auth": "^1.7.5",
    "expo": "~57.0.25",
    "expo-constants": "~57.0.19",
    "expo-linking": "~57.0.11",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.23",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "hono": "^4.13.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.3"
  },
  "devDependencies": {
    "@app/api": "workspace:*",
    "@app/testing": "workspace:*",
    "@inlang/paraglide-js": "^2.25.4",
    "@playwright/test": "^1.63.0",
    "@types/react": "~19.2.0",
    "typescript": "~6.0.3",
    "wrangler": "^4.136.3"
  }
}
