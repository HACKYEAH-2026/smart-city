{
  "name": "twoje-miejsce",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*",
    "plugins/*"
  ],
  "scripts": {
    "verify": "bun scripts/verify.ts",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "typecheck": "bun run --filter '*' typecheck",
    "test:unit": "bun test ./packages ./plugins ./apps/app/src",
    "test:int": "bun test ./apps/api/test",
    "db:generate": "bun run --cwd apps/api db:generate",
    "db:check": "bun run --cwd apps/api db:check",
    "e2e": "bun run --cwd apps/app e2e",
    "build": "bun run --cwd apps/api build && bun run --cwd apps/app build",
    "android": "bun run --cwd apps/app android:debug",
    "dev": "bun run --filter '@app/api' --filter '@app/app' dev",
    "plugin:upload": "bun scripts/plugin-upload.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/bun": "latest",
    "typescript": "~6.0.3"
  }
}
