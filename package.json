{
  "name": "twoje-miejsce",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*",
    "plugins/*",
    "demo-video"
  ],
  "scripts": {
    "verify": "bun scripts/verify.ts",
    "lint": "biome ci --error-on-warnings .",
    "format": "biome check --write .",
    "typecheck": "bun run --parallel --no-exit-on-error --filter '*' typecheck",
    "test:unit": "bun scripts/bun-test.ts ./packages ./plugins ./apps/app/src ./apps/api/src",
    "test:int": "bun scripts/bun-test.ts ./apps/api/test",
    "db:check": "bun run --cwd apps/api db:check",
    "e2e": "bun run --cwd apps/app e2e",
    "build": "bun run --cwd apps/api build && bun run --cwd apps/app build",
    "android": "bun run --cwd apps/app android:debug",
    "dev": "bun run --filter '@app/api' --filter '@app/app' dev",
    "plugin:upload": "bun scripts/plugin-upload.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/bun": "1.4.2",
    "typescript": "~6.0.3"
  }
}
