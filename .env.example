# Settings of the local dev API (`just dev`, `just api`, `bun run dev`): its dev script loads this repo's .env
# with `--env-file`, and so do the ad's media scripts (`bun run vo`, `bun run media` in demo-video). Nothing else reads it:
# bunfig.toml turns off Bun's automatic .env loading, so tests, E2E and `bun run verify` never see these values
# (they never call a real model).
# Copy this file to .env (gitignored) and uncomment what you need; everything here is optional in dev.
# A variable set to an empty value fails validation (apps/api/src/env.ts), so keep unused ones commented out.
# Restart the api process after editing (mprocs: select "api", press r). Production secrets: GitHub Secrets only.

# Language model for ctx.ai (Strands Agents + an OpenAI-compatible API). Needs both AI_API_KEY and AI_MODEL;
# without them ctx.ai.call is unavailable and findSimilar matches shared words.
# AI_API_KEY=sk-...
# AI_MODEL=gpt-5-mini
# Another OpenAI-compatible provider; unset = api.openai.com.
# AI_BASE_URL=https://...
# Embedding model for ctx.ai.embed (same key and endpoint; needs AI_API_KEY); without it ctx.ai.embed is unavailable.
# AI_EMBEDDING_MODEL=text-embedding-3-small

# Google sign-in (docs/expo.md): client IDs of the "Web application" and "iOS" OAuth clients.
# GOOGLE_CLIENT_ID=
# GOOGLE_IOS_CLIENT_ID=

# Expo push, only if the Expo project enables enhanced push security.
# EXPO_ACCESS_TOKEN=

# ElevenLabs, for the ad's voice-over (demo-video/scripts/voiceover.ts). Every take is paid per character.
# ELEVEN_LABS_API_KEY=sk_...

# Gemini API, for the ad's generated stills and clips (demo-video/scripts/media.ts). Paid per image and per second.
# GEMINI_API_KEY=...
